# ------------------------------------
# Environment Profile
# ------------------------------------
FLASK_ENV=development
APP_PROFILE=development

# ------------------------------------
# Security
# ------------------------------------
JWT_SECRET_KEY=replace-with-a-strong-secret-at-least-32-chars

# ------------------------------------
# Database (fallback/default)
# ------------------------------------
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/web_admin?charset=utf8mb4
DATABASE_SHOW_SQL=true

# Profile-style overrides (inspired by config.yml multi-profile)
DATABASE_URL__DEVELOPMENT=mysql+pymysql://root:123456@localhost:3306/web_admin?charset=utf8mb4
DATABASE_SHOW_SQL__DEVELOPMENT=true

DATABASE_URL__TESTING=sqlite:///:memory:
DATABASE_SHOW_SQL__TESTING=false

DATABASE_URL__PRODUCTION=mysql+pymysql://username:password@db-host:3306/web_admin?charset=utf8mb4
DATABASE_SHOW_SQL__PRODUCTION=false

# create_engine pool options
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# ------------------------------------
# Celery / Redis
# ------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------
# CORS
# ------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------
# Permission localization
# ------------------------------------
PERMISSION_CN_SYNC_ON_STARTUP=true
