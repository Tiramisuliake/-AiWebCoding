# 数据库（与 web-admin 共享同一个库，quant 表用 quant_ 前缀）
# 如果 web-admin/backend/.env 已配置 DATABASE_URL，可以不设此项
QUANT_DB_URI=mysql+pymysql://root:yourpassword@localhost:3306/web_admin?charset=utf8mb4

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs

# 数据采集
DATA_START_DATE=20230101

# 分钟级数据
MINUTE_PERIODS=5,15,60
MINUTE_RETAIN_DAYS=60

# 实时行情推送
REALTIME_WS_HOST=0.0.0.0
REALTIME_WS_PORT=8765
REALTIME_POLL_INTERVAL=3

# 多因子选股
MULTI_FACTOR_TOP_N=20
MULTI_FACTOR_WEIGHTS={"return_20d":0.3,"return_60d":0.2,"volatility_20d":0.2,"turnover":0.3}
